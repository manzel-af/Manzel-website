# Copy to .env.local. Both Supabase values are the same public pair the app
# ships with; the website only reads platform_settings (the fee and the
# support contacts), which anon may read. NEVER put the service-role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# The site's real public origin, no trailing slash. Used for canonical URLs,
# hreflang alternates, sitemap.xml and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://www.example.af

# The launch switch (lib/mode.ts). Leave it unset — or anything but "live" —
# and the whole site is the coming-soon page. Set SITE_MODE=live on launch day
# and redeploy to switch the full website on.
# SITE_MODE=live
